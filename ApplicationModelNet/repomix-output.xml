        // ИЛИ если был мягко удален сам привязанный технологический параметр (Parameter)
        builder.HasQueryFilter(x =>
            x.DeletedAt == null &&
            EF.Property<DateTime?>(x.Parameter, "DeletedAt") == null);
    }
}

        var parentId = Guid.NewGuid();
        var childId = Guid.NewGuid();

        await service.AddAsync(new TestTreeEntity { Id = parentId, Name = "Parent" });
        await service.AddAsync(new TestTreeEntity { Id = childId, Name = "Child", ParentId = parentId });


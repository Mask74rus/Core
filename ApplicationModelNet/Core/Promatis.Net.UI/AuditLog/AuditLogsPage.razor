@page "/admin/audit-logs"

@using Promatis.Net.Domain
@using Promatis.Net.UI
@using System.Text.Json
@inherits Promatis.Net.UI.BaseDataGrid<Promatis.Net.Domain.AuditLog>

<MudText Typo="Typo.h5" Class="mb-4">Журнал аудита системы</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="3" Justify="Justify.FlexStart">
        <MudItem xs="12" sm="4">
            <MudDateRangePicker Label="Период логов"
                                DateRange="LogDateRange"
                                DateRangeChanged="OnDateRangeChanged"
                                Clearable="false" />
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudAutocomplete T="string"
                             Label="Сущность (Таблица)"
                             Value="SelectedEntity"
                             ValueChanged="OnEntityChanged"
                             SearchFunc="SearchEntitiesAsync"
                             ResetValueOnEmptyText="true"
                             CoerceText="true"
                             Clearable="true" />
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudSelect T="string"
                       Label="Действие"
                       Value="SelectedAction"
                       ValueChanged="OnActionChanged"
                       Clearable="true">
                <MudSelectItem Value="@("Added")">Добавление (Added)</MudSelectItem>
                <MudSelectItem Value="@("Modified")">Изменение (Modified)</MudSelectItem>
                <MudSelectItem Value="@("Deleted")">Удаление (Deleted)</MudSelectItem>
                <MudSelectItem Value="@("SoftDeleted")">Мягкое удаление (SoftDeleted)</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudDataGrid @ref="Grid"
             T="GridRowModel<AuditLog>"
             ServerData="LoadGridDataAsyncInternal"
             Hover="true"
             Bordered="true"
             Striped="true"
             Loading="IsLoading">
    <Columns>
        <HierarchyColumn T="GridRowModel<AuditLog>" ButtonPosition="HierarchyColumnButtonPosition.Left" />
        <PropertyColumn Property="x => x.DomainEntity.ChangedAt" Title="Дата/Время" Format="dd.MM.yyyy HH:mm:ss" Sortable="false" />
        <PropertyColumn Property="x => x.DomainEntity.ChangedBy" Title="Пользователь" Sortable="false" />
        <PropertyColumn Property="x => x.DomainEntity.EntityName" Title="Сущность" Sortable="false" />
        <PropertyColumn Property="x => x.DomainEntity.Action" Title="Действие" Sortable="false">
            <CellTemplate>
                @{
                    var action = context.Item.DomainEntity.Action;
                    var color = action switch
                    {
                        "Added" => Color.Success,
                        "Modified" => Color.Info,
                        "Deleted" or "SoftDeleted" => Color.Error,
                        _ => Color.Default
                    };
                }
                <MudChip T="string" Color="color" Size="Size.Small" Variant="Variant.Text">@action</MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.DomainEntity.EntityId" Title="ID Объекта" Sortable="false" />
    </Columns>

    <ChildRowContent>
        <MudCard Elevate="0" Class="ma-2 bg-light">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-2">Измененные свойства:</MudText>
                @try
                {
                    using var doc = JsonDocument.Parse(context.Item.DomainEntity.ChangesJson);
                    if (doc.RootElement.ValueKind == JsonValueKind.Array)
                    {
                        <table class="mud-table-root" style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 1px solid var(--mud-palette-divider);">
                                    <th style="padding: 8px; text-align: left;">Свойство</th>
                                    @if (context.Item.DomainEntity.Action == "Modified")
                                    {
                                        <th style="padding: 8px; text-align: left;">Старое значение</th>
                                    }
                                    <th style="padding: 8px; text-align: left;">Новое значение</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in doc.RootElement.EnumerateArray())
                                {
                                    <tr style="border-bottom: 1px solid var(--mud-palette-table-lines);">
                                        <td style="padding: 8px; font-weight: 500;">@prop.GetProperty("PropertyName").GetString()</td>
                                        @if (context.Item.DomainEntity.Action == "Modified")
                                        {
                                            <td style="padding: 8px; color: var(--mud-palette-error);">
                                                @(prop.TryGetProperty("OriginalValue", out var oldVal) ? oldVal.ToString() : "—")
                                            </td>
                                        }
                                        <td style="padding: 8px; color: var(--mud-palette-success);">
                                            @(prop.TryGetProperty("CurrentValue", out var newVal) ? newVal.ToString() :
                                              prop.TryGetProperty("NewValue", out var addedVal) ? addedVal.ToString() : "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
                catch
                {
                    <MudText Color="Color.Warning" Typo="Typo.caption">Ошибка парсинга данных: @context.Item.DomainEntity.ChangesJson</MudText>
                }
            </MudCardContent>
        </MudCard>
    </ChildRowContent>

    <PagerContent>
        <MudDataGridPager T="GridRowModel<AuditLog>" RowsPerPageString="Строк на странице:" InfoFormat="{first_item}-{last_item} из {all_items}" />
    </PagerContent>
</MudDataGrid>
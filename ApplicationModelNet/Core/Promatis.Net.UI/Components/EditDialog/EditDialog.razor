@namespace Promatis.Net.UI.Components.EditDialog

@inherits Microsoft.AspNetCore.Components.ComponentBase

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsNew ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Class="mr-2 mb-n1" />
            @Title
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form"
                 Model="@Model"
                 Validation="@(async (object m) => await ExecuteFluentValidationAsync(m))"
                 ValidationDelay="200">

            <div class="d-flex flex-column gap-4 pt-2">
                @if (_isProcessing)
                {
                    <div class="d-flex justify-center my-4">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else
                {
                    @* АВТОМАТИКА ВКЛАДОК: Если вкладка одна — скрываем панель переключения *@
                    @if (Tabs.Count == 1)
                    {
                        @Tabs.First().Content
                    }
                    else if (Tabs.Count > 1)
                    {
                        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToInnerContainer="true" PanelClass="pa-4">
                            @foreach (DialogTab tab in Tabs)
                            {
                                <MudTabPanel Text="@tab.Title" Icon="@tab.Icon">
                                    @tab.Content
                                </MudTabPanel>
                            }
                        </MudTabs>
                    }
                }
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_isProcessing">Отмена</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_isProcessing">
            @if (_isProcessing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Сохранение...</MudText>
            }
            else
            {
                <MudText>Сохранить</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>
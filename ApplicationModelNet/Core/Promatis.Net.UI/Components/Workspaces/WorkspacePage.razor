<MudPaper Elevation="@GetPaperElevation()"
          Class="@GetPaperClass()"
          Style="@($"width: 100%; height: {GetWorkspaceHeight()}; overflow: hidden;")">
    @* ИСПРАВЛЕНО: min-height заменена на height *@

    <!-- 1. ВЕРХНЯЯ ЗОНА (ЗАПОЛНЯЕТСЯ ТОЛЬКО ПРИ НАЛИЧИИ TOPCONTENT) -->
    @if (TopContent != null && !IsTopCollapsed())
    {
        <div class="workspace-zone-top w-100 mb-2"
             style="@($"height: {GetTopHeight()}; min-height: {GetTopHeight()}; max-height: {GetTopHeight()}; flex-shrink: 0;")">
            @TopContent
        </div>
    }

    <!-- СРЕДНИЙ СЛОЙ (ЛЕВАЯ ЗОНА + БОДИ + ПРАВАЯ ЗОНА) -->
    <div class="d-flex flex-row align-stretch flex-grow-1 gap-4 w-100" style="min-height: 0; height: 100%; overflow: hidden;">

        <!-- 2. ЛЕВАЯ ЗОНА (НАВИГАЦИЯ / ДЕРЕВО) -->
        @if (LeftContent != null && !IsLeftCollapsed())
        {
            @* ИСПРАВЛЕНО: Добавлен скролл overflow-y: auto для защиты от переполнения деревом *@
            <div class="workspace-zone-left d-flex flex-column align-stretch justify-space-between"
                 style="@($"width: {GetLeftWidth()}; min-width: {GetLeftWidth()}; max-width: {GetLeftWidth()}; overflow-y: auto;")">
                @LeftContent
            </div>
        }

        <!-- 3. ЦЕНТРАЛЬНАЯ ЗОНА (БОДИ: ГРИД / МНЕМОСХЕМА) -->
        @* ИСПРАВЛЕНО: Убран h-100, добавлены классы d-flex flex-column для каскадной передачи высоты внутрь GridPage *@
        <div class="workspace-zone-body d-flex flex-column flex-grow-1" style="min-width: 0; min-height: 0; overflow: hidden;">
            @if (BodyContent != null)
            {
                @BodyContent
            }
        </div>

        <!-- 4. ПРАВАЯ ЗОНА (ИНСПЕКТОР СВОЙСТВ) -->
        @if (RightContent != null && !IsRightCollapsed())
        {
            @* ИСПРАВЛЕНО: Добавлен скролл overflow-y: auto для защиты от переполнения инспектором *@
            <div class="workspace-zone-right d-flex flex-column align-stretch justify-space-between"
                 style="@($"width: {GetRightWidth()}; min-width: {GetRightWidth()}; max-width: {GetRightWidth()}; overflow-y: auto;")">
                @RightContent
            </div>
        }

    </div>

    <!-- 5. НИЖНЯЯ ЗОНА (СТАТУС-БАР) -->
    @if (BottomContent != null && !IsBottomCollapsed())
    {
        <div class="workspace-zone-bottom w-100 mt-2"
             style="@($"height: {GetBottomHeight()}; min-height: {GetBottomHeight()}; max-height: {GetBottomHeight()}; flex-shrink: 0;")">
            @BottomContent
        </div>
    }

</MudPaper>
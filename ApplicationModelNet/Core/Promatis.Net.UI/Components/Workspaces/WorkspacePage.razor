@* Базовый геометрический каркас 5 зон экрана платформы *@
<MudPaper Elevation="@Context.PaperElevation"
          Class="@Context.PaperClass"
          Style="@($"height: {Context.WorkspaceHeight}; position: relative; overflow: hidden;")">

    @* НАДЭКРАННЫЙ ОВЕРЛЕЙ ЗАГРУЗКИ: Нативно считывает состояние из каскадного контекста *@
    <MudOverlay Visible="@Context.IsLoading" DarkBackground="false" Absolute="true" ZIndex="9999">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </MudOverlay>

    @* ВЕРХНЯЯ ЗОНА (Тулбары / Панели фильтрации) *@
    @if (TopContent != null && !Context.IsTopZoneCollapsed)
    {
        <div class="workspace-top-zone flex-none" style="height: @Context.TopZoneHeight; width: 100%;">
            @TopContent
        </div>
    }

    @* СРЕДНИЙ МАКЕТ ХОЛСТА (Левая панель + Центральное тело + Правая панель) *@
    <div class="d-flex flex-row flex-grow-1 w-100 h-100 min-w-0" style="overflow: hidden;">

        @* ЛЕВАЯ ЗОНА (Древовидная навигация / Декларативные фильтры) *@
        @if (LeftContent != null && !Context.IsLeftZoneCollapsed)
        {
            <div class="workspace-left-zone flex-none" style="width: @Context.LeftZoneWidth; height: 100%;">
                @LeftContent
            </div>
        }

        @* ЦЕНТРАЛЬНОЕ ТЕЛО (Основной рабочий контент: Таблицы / Схемы / Документы) *@
        <div class="workspace-body-zone flex-grow-1 h-100 min-w-0" style="position: relative;">
            @BodyContent
        </div>

        @* ПРАВАЯ ЗОНА (Инспекторы свойств / Детализация) *@
        @if (RightContent != null && !Context.IsRightZoneCollapsed)
        {
            <div class="workspace-right-zone flex-none" style="width: @Context.RightZoneWidth; height: 100%;">
                @RightContent
            </div>
        }
    </div>

    @* НИЖНЯЯ ЗОНА (Статус-бар / Итоговые показатели) *@
    @if (BottomContent != null && !Context.IsBottomZoneCollapsed)
    {
        <div class="workspace-bottom-zone flex-none" style="height: @Context.BottomZoneHeight; width: 100%;">
            @BottomContent
        </div>
    }

</MudPaper>
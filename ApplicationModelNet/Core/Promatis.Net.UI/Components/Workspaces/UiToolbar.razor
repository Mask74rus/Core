
<div class="mud-toolbar mud-toolbar-dense gap-4 pa-0 w-100 align-center" style="display: flex; min-height: 48px;">
    @if (Controls != null)
    {
        @foreach (IUiControl control in Controls)
        {
            @if (!control.IsVisible) continue;

            <!-- Динамический маршалинг компонента и параметров любого уровня (Core, MES, MDM) -->
            <DynamicComponent Type="@control.ComponentType"
                              Parameters="@control.ComponentParameters" />
        }
    }
</div>

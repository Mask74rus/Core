@typeparam TEntity where TEntity : class

<MudDataGrid Items="@Items"
             @bind-SelectedItem="@SelectedRow"
             T="TEntity"
             SelectOnRowClick="true"
             Hover="true"
             Dense="true"
             Virtualize="true"
             Height="100%"
             Class="flex-grow-1 w-100 cursor-pointer">
    <Columns>
        @GridColumns
    </Columns>
</MudDataGrid>

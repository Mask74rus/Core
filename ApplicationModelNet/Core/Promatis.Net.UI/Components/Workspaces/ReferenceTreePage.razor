@typeparam TEntity where TEntity : Promatis.Net.Domain.ReferenceTreeBase<TEntity>, new()

<CascadingValue Value="@((IWorkspaceContext)Context)">
    <WorkspacePage>

        @* 1. ВЕРХНЯЯ ЗОНА: Автоматический тулбар кнопок управления деревом *@
        <TopContent>
            <UiToolbar Controls="@(((IToolbarContext)Context).Controls)" />
        </TopContent>

        @* 2. ЦЕНТРАЛЬНАЯ ЗОНА: Древовидная структура, принимающая готовый граф элементов *@
        <BodyContent>
            @* СВЯЗУЮЩИЙ МОСТ: Передаем готовый TreeGraph и привязываем OnNodeSelected напрямую к стейту контекста *@
            <TreePage TEntity="TEntity"
                      RootItems="@TreeGraph"
                      TextSelector="@(x => string.IsNullOrWhiteSpace(x.Code) ? x.Name : $"[{x.Code}] {x.Name}")"
                      IconSelector="@(x => x.Children != null && x.Children.Any() ? Icons.Material.Filled.Folder : Icons.Material.Filled.InsertDriveFile)"
                      OnNodeSelected="@(x => Context.SelectedData = x)" />
        </BodyContent>

    </WorkspacePage>
</CascadingValue>
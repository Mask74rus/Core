@typeparam TEntity where TEntity : class, new()

@using Promatis.Net.Domain

@* Наш новый полиморфный диалог, который сам отрендерит кнопки Сохранить/Отмена *@
<DynamicEditDialog Context="@Context" Title="@Title">
    <Tabs>
        <MudTabs Elevation="0" Rounded="true">
            <DialogTab Title="Основная информация" 
                       Icon="@Icons.Material.Filled.Info"
                       PropertyNames="@(new[] { nameof(ReferenceBase.Code), nameof(ReferenceBase.Name), nameof(ReferenceBase.Description) })">
                <Content>
                    <div class="d-flex flex-column gap-4 w-100">
                        @{
                            var referenceModel = (ReferenceBase)(object)Context.Model;
                        }

                        @* ИСПРАВЛЕНО: Посимвольная валидация привязана напрямую к инпуту через ValidatePropertyAsync *@
                        <MudTextField @bind-Value="@referenceModel.Code"
                                      Label="Код справочника"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      For="@(() => referenceModel.Code)" />

                        <MudTextField @bind-Value="@referenceModel.Name"
                                      Label="Наименование"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      For="@(() => referenceModel.Name)" />

                        <MudTextField @bind-Value="@referenceModel.Description"
                                      Label="Описание / Примечание"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      For="@(() => referenceModel.Description)" />
                    </div>
                </Content>
            </DialogTab>
        </MudTabs>
    </Tabs>
</DynamicEditDialog>

@typeparam TEntity where TEntity : class, IDomainObjectHasKey<Guid>, new()
@using Promatis.Net.Domain 

<CascadingValue Value="Context" IsFixed="true">
    <WorkspacePage>

        <!-- 1. ВЕРХНЯЯ ЗОНА: Автоматический полиморфный тулбар с CRUD-операциями -->
        <TopContent>
            <UiToolbar Controls="@Context.Controls" />
        </TopContent>

        <!-- 2. ЦЕНТРАЛЬНАЯ ЗОНА: Табличная сетка справочника -->
        <BodyContent>
            <GridPage TEntity="TEntity"
                      @ref="_grid"
                      ServerDataProvider="@Context.Broker.FetchDataAsync">
                <GridColumns>
                    <PropertyColumn T="TEntity" TProperty="string" Property="x => ((ReferenceBase)(object)x).Code" Title="Код" HeaderStyle="width: 150px;" />
                    <PropertyColumn T="TEntity" TProperty="string" Property="x => ((ReferenceBase)(object)x).Name" Title="Наименование" HeaderStyle="width: auto;" />
                    <PropertyColumn T="TEntity" TProperty="string" Property="x => ((ReferenceBase)(object)x).Description" Title="Описание" HeaderStyle="width: auto;" />
                </GridColumns>
            </GridPage>
        </BodyContent>

    </WorkspacePage>
</CascadingValue>
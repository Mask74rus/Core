@using Promatis.Net.UI.Components.BaseTree
@typeparam TEntity where TEntity : class

<!-- Спускаем каскадом типизированный контекст вниз для дочерних таблиц/деревьев -->
<CascadingValue Value="@ActionContext" IsFixed="true">
    <CascadingValue Value="@((WorkspaceActionContext)ActionContext)" IsFixed="true">

        <BaseWorkspacePage BodyContent="@ChildContent"
                           TopContent="@(CurrentPosition == ToolbarPosition.Top ? _renderGeneratedToolbar : null)"
                           BottomContent="@(CurrentPosition == ToolbarPosition.Bottom ? _renderGeneratedToolbar : null)"
                           LeftContent="@(CurrentPosition == ToolbarPosition.Left ? _renderGeneratedToolbar : null)"
                           RightContent="@(CurrentPosition == ToolbarPosition.Right ? _renderGeneratedToolbar : null)" />

    </CascadingValue>
</CascadingValue>

@code {
#nullable enable

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? AdditionalToolbarContent { get; set; }
    [Parameter] public ToolbarActionContext<TEntity> ActionContext { get; set; } = null!;

    [Parameter] public EventCallback OnCreateTriggered { get; set; }
    [Parameter] public EventCallback<TEntity> OnEditTriggered { get; set; }
    [Parameter] public EventCallback<TEntity> OnDeleteTriggered { get; set; }
    [Parameter] public EventCallback<TEntity> OnCreateChildTriggered { get; set; }

    private ToolbarPosition CurrentPosition => ActionContext?.Position ?? ToolbarPosition.Top;
    private bool _isVertical => CurrentPosition == ToolbarPosition.Left || CurrentPosition == ToolbarPosition.Right;

    private RenderFragment? _renderGeneratedToolbar => __builder =>
    {
        if (ActionContext == null || !ActionContext.IsToolbarVisible) return;

        if (_isVertical)
        {
            string zoneWidth = CurrentPosition == ToolbarPosition.Left ? ActionContext.LeftZoneWidth : ActionContext.RightZoneWidth;

            <div class="d-flex flex-column align-stretch justify-space-between bg-light pa-3 rounded shadow-sm h-100"
                 style="@($"width: {zoneWidth}; min-width: {zoneWidth}; max-width: {zoneWidth};")">
                <div class="d-flex flex-column gap-2">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-center border-bottom pb-2 mb-2">
                        @ActionContext.PageTitle
                    </MudText>
                    @_renderButtonsCollection
                </div>
            </div>
        }
        else
        {
            string zoneHeight = CurrentPosition == ToolbarPosition.Top ? ActionContext.TopZoneHeight : ActionContext.BottomZoneHeight;

            <div class="d-flex align-center justify-space-between bg-light pa-2 rounded shadow-sm w-100"
                 style="@($"height: {zoneHeight}; min-height: {zoneHeight}; max-height: {zoneHeight};")">
                <div class="d-flex align-center gap-2 flex-wrap">
                    @_renderButtonsCollection
                </div>
            </div>
        }
    };

    private RenderFragment _renderButtonsCollection => __builder =>
    {
        // 1. Проверяем, запущен ли медиатор в режиме дерева
        bool isTreeMode = ActionContext is TreeActionContext<TEntity>;

        // 2. Безопасно извлекаем специфичные флаги дерева, если проверка пройдена
        bool isCreateChildVisible = isTreeMode && ((TreeActionContext<TEntity>)ActionContext).IsCreateChildVisible;
        bool isCreateChildEnabled = isTreeMode && ((TreeActionContext<TEntity>)ActionContext).IsCreateChildEnabled;

        if (ActionContext!.IsCreateVisible)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       Disabled="@(!ActionContext.IsCreateEnabled)" OnClick="OnCreateClick">Создать</MudButton>
        }

        @* ИСПРАВЛЕНО: Кнопка рендерится строго на основе безопасных локальных переменных *@
        if (isCreateChildVisible)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       Disabled="@(!isCreateChildEnabled)" OnClick="OnCreateChildClick">Добавить подузел</MudButton>
        }

        if (ActionContext.IsEditVisible)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                       Disabled="@(!ActionContext.IsEditEnabled)" OnClick="OnEditClick">Изменить</MudButton>
        }
        if (ActionContext.IsDeleteVisible)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                       Disabled="@(!ActionContext.IsDeleteEnabled)" OnClick="OnDeleteClick">Удалить</MudButton>
        }

        if (AdditionalToolbarContent != null)
        {
            if (ActionContext.IsCreateVisible || isCreateChildVisible || ActionContext.IsEditVisible || ActionContext.IsDeleteVisible)
            {
                <MudDivider Vertical="@(!_isVertical)" FlexItem="true" Class="mx-2 my-1" />
            }
            @AdditionalToolbarContent
        }

        if (ActionContext.CustomActions.Any(a => a.IsVisible) &&
            (ActionContext.IsCreateVisible || isCreateChildVisible || ActionContext.IsEditVisible || ActionContext.IsDeleteVisible || AdditionalToolbarContent != null))
        {
            <MudDivider Vertical="@(!_isVertical)" FlexItem="true" Class="mx-2 my-1" />
        }

        foreach (ToolbarCustomAction action in ActionContext.CustomActions.Where(a => a.IsVisible))
        {
            <MudButton Variant="@action.Variant"
                       Color="@action.Color"
                       Size="Size.Small"
                       StartIcon="@action.Icon"
                       Disabled="@(!action.IsEnabled)"
                       OnClick="@action.OnExecute">
                @action.Title
            </MudButton>
        }
    };
}
@code {
    [Parameter] public required string Title { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public required RenderFragment Content { get; set; }

    // --- НАШ НОВЫЙ ПАРАМЕТР МЕТАДАННЫХ ---
    /// <summary>
    /// Список доменных свойств (полей), которые физически расположены на этой вкладке.
    /// Необходим для автоматического фокуса вкладки при ошибках валидации.
    /// </summary>
    [Parameter] public string[] PropertyNames { get; set; } = Array.Empty<string>();

    [CascadingParameter] protected DynamicEditDialog ParentDialog { get; set; } = null!;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (ParentDialog != null)
        {
            ParentDialog.RegisterTab(this);
        }
    }
}
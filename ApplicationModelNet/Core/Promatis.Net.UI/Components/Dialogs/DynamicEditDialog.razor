<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @* Текст и иконка шапки теперь могут гибко настраиваться или браться по дефолту *@
            @Title
        </MudText>
    </TitleContent>

    <DialogContent>
        @* Скрытый стабильный сборщик вкладок *@
        <div style="display: none;">
            <CascadingValue Value="Context" IsFixed="true">
                <CascadingValue Value="this" IsFixed="true">
                    @Tabs
                </CascadingValue>
            </CascadingValue>
        </div>

        @* Метод ExecuteFluentValidationAsync проброшен из контекста-медиатора *@
        <MudForm @ref="_form"
                 Model="@Context.ModelObject"
                 Validation="@(async (object m) => await Context.ExecuteFluentValidationAsync(m))"
                 ValidationDelay="200">

            @* Контейнер жестко держит высоту окна фиксированной *@
            <div class="d-flex flex-column pt-2" style="min-height: 340px; max-height: 65vh; min-width: 0;">
                @if (Context.IsProcessing)
                {
                    <div class="d-flex flex-column align-center justify-center flex-grow-1" style="min-height: 200px;">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else
                {
                    @* АВТОМАТИКА РЕНДЕРИНГА: Если вкладка одна — даем ей скроллбар напрямую *@
                    @if (_collectedTabs.Count == 1)
                    {
                        <div style="max-height: 60vh; overflow-y: auto; padding-right: 4px;">
                            @_collectedTabs.First().Content
                        </div>
                    }
                    else if (_collectedTabs.Count > 1)
                    {
                        @* ВЕРСТКА ПО СТАНДАРТУ MUDBLAZOR 9.4: Скролл задан через стандартный Style *@
                        <MudTabs Elevation="0"
                                 Rounded="true"
                                 Class="pa-4"
                                 Style="max-height: 50vh; overflow-y: auto;">
                            @foreach (DialogTab tab in _collectedTabs)
                            {
                                <MudTabPanel Text="@tab.Title" Icon="@tab.Icon">
                                    @tab.Content
                                </MudTabPanel>
                            }
                        </MudTabs>
                    }
                }
            </div>
        </MudForm>
    </DialogContent>

    <DialogActions>
        @* ПОЛИМОРФНАЯ ПАНЕЛЬ ДЕЙСТВИЙ: Отрисовываем любые кнопки, переданные в контекст *@
        @foreach (var action in Context.Actions)
        {
            @if (!action.IsVisible) continue;

            <DynamicComponent Type="@action.ComponentType"
                              Parameters="@action.ComponentParameters" />
        }
    </DialogActions>
</MudDialog>

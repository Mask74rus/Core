<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <CascadingValue Value="this" IsFixed="true">
            @Tabs
        </CascadingValue>

        @* Валидация запускается ТОЛЬКО формой через Context *@
        <MudForm @ref="_form"
                 Model="@Context.ModelObject"
                 Validation="@(async (object m) => await Context.ExecuteFluentValidationAsync(m))"
                 ValidationDelay="0">
            @* Убираем задержку, так как проверяем только при Submit *@

            <div class="d-flex flex-column pt-2" style="min-height: 340px; max-height: 65vh; min-width: 0;">
                @if (Context.IsProcessing)
                {
                    <div class="d-flex justify-center my-4">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                }
                else
                {
                    @* Используем MudTabs всегда, управляя переменной @bind-ActivePanelIndex *@
                    <MudTabs Elevation="0"
                             Rounded="true"
                             @bind-ActivePanelIndex="_activeTabIndex">
                        @foreach (var tab in _collectedTabs)
                        {
                            <MudTabPanel Text="@tab.Title" Icon="@tab.Icon" PanelClass="pa-4">
                                <div style="max-height: 50vh; overflow-y: auto; padding-right: 4px;">
                                    @tab.Content
                                </div>
                            </MudTabPanel>
                        }
                    </MudTabs>
                }
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        @foreach (var action in Context.Actions)
        {
            @if (!action.IsVisible) continue;
            <DynamicComponent Type="@action.ComponentType" Parameters="@action.ComponentParameters" />
        }
    </DialogActions>
</MudDialog>

@typeparam TEntity where TEntity : class

<div class="promatis-tree-container w-100 h-100">
    <BaseToolbarWorkspacePage TEntity="TEntity"
                              ActionContext="@ActionContext"
                              OnCreateTriggered="OnCreateRootClick"
                              OnCreateChildTriggered="OnCreateChildClick"
                              OnEditTriggered="OnEditNodeClick"
                              OnDeleteTriggered="OnDeleteNodeClick"
                              AdditionalToolbarContent="@AdditionalToolbarContent">
        <ChildContent>
            @if (IsLoading)
            {
                <div class="d-flex justify-center align-center w-100" style="height: calc(100vh - 245px);">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                </div>
            }
            else if (Items == null || !Items.Any())
            {
                @if (EmptyContent != null)
                {
                    @EmptyContent
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center my-8" style="min-height: 400px;">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Default" Class="mud-text-disabled" Style="font-size: 4rem;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-4">Данные иерархии пусты</MudText>
                    </div>
                }
            }
            else
            {
                <div class="w-100 pr-2" style="height: calc(100vh - 245px); overflow-y: auto; overflow-x: hidden;">
                    <MudTreeView T="TEntity"
                                 Items="@Items"
                                 @bind-SelectedValue="@SelectedTreeValue"
                                 Hover="true"
                                 Dense="true">
                        <ItemTemplate Context="item">
                            @{
                                TEntity? domainEntity = item.Value;
                                bool isSelected = item.Selected;
                                string activeStyle = isSelected ? "background-color: var(--mud-palette-action-disabled-background) !important; color: var(--mud-palette-text-primary) !important; border-radius: 4px; font-weight: 500;" : "cursor: pointer;";
                            }

                            <MudTreeViewItem Value="@domainEntity"
                                             Items="@item.Children"
                                             @bind-Expanded="@item.Expanded"
                                             Text="@(ItemTextFunc != null && domainEntity != null ? ItemTextFunc(domainEntity) : domainEntity?.ToString())"
                                             Icon="@(ItemIconFunc != null && domainEntity != null ? ItemIconFunc(domainEntity) : string.Empty)"
                                             IconColor="@(isSelected ? Color.Primary : ItemIconColorFunc?.Invoke(domainEntity!) ?? Color.Default)"
                                             Style="@activeStyle"
                                             LoadingIcon="@Icons.Material.Filled.Refresh">

                                @if (NodeContent != null && domainEntity != null)
                                {
                                    @NodeContent(domainEntity)
                                }
                            </MudTreeViewItem>
                        </ItemTemplate>
                    </MudTreeView>
                </div>
            }
        </ChildContent>
    </BaseToolbarWorkspacePage>
</div>
@typeparam TEntity where TEntity : class

<style>
    /* Намертво принуждаем выделенный узел дерева принимать серый цвет и инвертировать текст */
    .promatis-tree-container .mud-tree-view-item-selected .mud-tree-view-item-content {
        background-color: var(--mud-palette-action-disabled-background) !important;
        color: var(--mud-palette-surface) !important;
        border-radius: 4px;
    }
        /* Инвертируем внутренние иконки, типографику и кастомный текст в выделенном узле */
        .promatis-tree-container .mud-tree-view-item-selected .mud-tree-view-item-content * {
            color: var(--mud-palette-surface) !important;
        }
</style>

<div class="promatis-tree-container w-100 h-100">
    <BaseToolbarWorkspacePage TEntity="TEntity"
                              ActionContext="@ActionContext"
                              OnCreateTriggered="OnCreateRootClick"
                              OnCreateChildTriggered="OnCreateChildClick"
                              OnEditTriggered="OnEditNodeClick"
                              OnDeleteTriggered="OnDeleteNodeClick"
                              AdditionalToolbarContent="@AdditionalToolbarContent">
        <ChildContent>
            @if (IsLoading)
            {
                <div class="d-flex justify-center align-center h-100" style="min-height: 400px;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                </div>
            }
            else if (Items == null || !Items.Any())
            {
                @if (EmptyContent != null)
                {
                    @EmptyContent
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center my-8" style="min-height: 400px;">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Default" Class="mud-text-disabled" Style="font-size: 4rem;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-4">Данные иерархии пусты</MudText>
                    </div>
                }
            }
            else
            {
                <MudTreeView T="TEntity" 
                             Items="@Items" 
                             ServerData="@ServerData"
                             SelectedValue="@ActionContext.SelectedData"
                             SelectedValueChanged="@OnSelectedValueChanged"
                             Hover="true"
                             Dense="true">
                    <ItemTemplate Context="item">
                        <MudTreeViewItem Value="@item.Value"
                                         Text="@(ItemTextFunc != null ? ItemTextFunc(item.Value!) : item.Value?.ToString())"
                                         CanExpand="@(CanExpandFunc == null || CanExpandFunc(item.Value!))"
                                         LoadingIcon="@Icons.Material.Filled.Refresh">

                            @if (NodeContent != null)
                            {
                                @NodeContent(item.Value!)
                            }

                        </MudTreeViewItem>
                    </ItemTemplate>
                </MudTreeView>
            }
        </ChildContent>
    </BaseToolbarWorkspacePage>
</div>
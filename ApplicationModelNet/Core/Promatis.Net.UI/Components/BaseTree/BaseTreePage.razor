@using Promatis.Net.UI.Components.BaseWorkspace
@typeparam TEntity where TEntity : class

<CascadingValue Value="@_treeContext" IsFixed="true">
    <CascadingValue Value="@((WorkspaceActionContext)_treeContext)" IsFixed="true">

        <BaseWorkspacePage PageTitle="@_treeContext.PageTitle"
                             Position="@_treeContext.Position"
                             ToolbarContent="@GetTreeToolbarFragment()"
                             BodyContent="@ChildContent" />

    </CascadingValue>
</CascadingValue>

@code {
    /// <summary>
    /// Слот для размещения самого дерева (например, MudTreeView)
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Слот расширения кнопок панели для конечного модуля
    /// </summary>
    [Parameter] public RenderFragment? AdditionalToolbarContent { get; set; }

    [Parameter] public EventCallback OnCreateRootTriggered { get; set; }
    [Parameter] public EventCallback OnCreateChildTriggered { get; set; }
    [Parameter] public EventCallback OnDeleteNodeTriggered { get; set; }

    private readonly TreeActionContext _treeContext = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _treeContext.PageTitle = "Иерархическая структура";
        _treeContext.Position = ToolbarPosition.Top;
        _treeContext.OnContextUpdated = StateHasChanged;
    }

    private RenderFragment GetTreeToolbarFragment() => __builder =>
    {
        @if (_treeContext.IsCreateRootVisible)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       Disabled="@(!_treeContext.IsCreateRootEnabled)" OnClick="OnCreateRootClick">
                Добавить корень
            </MudButton>
        }
        @if (_treeContext.IsCreateChildVisible)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       Disabled="@(!_treeContext.IsCreateChildEnabled)" OnClick="OnCreateChildClick">
                Добавить подузел
            </MudButton>
        }
        @if (_treeContext.IsDeleteNodeVisible)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                       Disabled="@(!_treeContext.IsDeleteNodeEnabled)" OnClick="OnDeleteNodeClick">
                Удалить узел
            </MudButton>
        }
        @if (AdditionalToolbarContent != null)
        {
            <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
            @AdditionalToolbarContent
        }
    };

    private async Task OnCreateRootClick() { if (OnCreateRootTriggered.HasDelegate) await OnCreateRootTriggered.InvokeAsync(); }
    private async Task OnCreateChildClick() { if (OnCreateChildTriggered.HasDelegate) await OnCreateChildTriggered.InvokeAsync(); }
    private async Task OnDeleteNodeClick() { if (OnDeleteNodeTriggered.HasDelegate) await OnDeleteNodeTriggered.InvokeAsync(); }
}
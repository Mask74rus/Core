@typeparam TEntity where TEntity : class

<div class="promatis-tree-container w-100 h-100">
    <BaseToolbarWorkspacePage TEntity="TEntity"
                              ActionContext="@ActionContext"
                              OnCreateTriggered="OnCreateRootClick"
                              OnCreateChildTriggered="OnCreateChildClick"
                              OnEditTriggered="OnEditNodeClick"
                              OnDeleteTriggered="OnDeleteNodeClick"
                              AdditionalToolbarContent="@AdditionalToolbarContent">
        <ChildContent>
            @if (IsLoading)
            {
                @* Лоадер со стартовой миллисекунды жестко держит высоту calc(100vh - 245px) *@
                <div class="d-flex justify-center align-center w-100"
                     style="height: calc(100vh - 245px); min-height: calc(100vh - 245px); max-height: calc(100vh - 245px);">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                </div>
            }
            else if (Items == null || !Items.Any())
            {
                @if (EmptyContent != null)
                {
                    @EmptyContent
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center my-8" style="min-height: 400px;">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Default" Class="mud-text-disabled" Style="font-size: 4rem;" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-4">Данные иерархии пусты</MudText>
                    </div>
                }
            }
            else
            {
                @* Скролл-бокс дерева жестко зажимает MDI-рамки на высоте calc(100vh - 245px) *@
                <div class="w-100 pr-2"
                     style="height: calc(100vh - 245px); min-height: calc(100vh - 245px); max-height: calc(100vh - 245px); overflow-y: auto; overflow-x: hidden;">

                    <MudTreeView T="TEntity"
                                 Items="@Items"
                                 ServerData="@ServerData"
                                 Hover="true"
                                 Dense="true">
                        <ItemTemplate Context="item">
                            @{
                                bool canExpand = CanExpandFunc == null || CanExpandFunc(item.Value!);
                                bool isSelected = ActionContext.SelectedData == item.Value;

                                // ДИНАМИЧЕСКИЙ РАСЧЕТ ИНЛАЙН-СТИЛЕЙ СТРОКИ:
                                // Пробиваем рендеринг MudBlazor на атомарном уровне, забирая серый цвет из темы!
                                string activeStyle = isSelected
                                    ? "background-color: var(--mud-palette-action-disabled-background) !important; color: var(--mud-palette-surface) !important; border-radius: 4px; font-weight: 500;"
                                    : "cursor: pointer;";
                            }

                            @* Нативно управляем подсветкой фона и текста через ContentStyle, а скрытием стрелки — через ExpandButtonIcon *@
                            <MudTreeViewItem Value="@item.Value"
                                             Text="@(ItemTextFunc != null ? ItemTextFunc(item.Value!) : item.Value?.ToString())"
                                             Icon="@(ItemIconFunc != null ? ItemIconFunc(item.Value!) : string.Empty)"
                                             IconColor="@(isSelected ? Color.Default : ItemIconColorFunc?.Invoke(item.Value!) ?? Color.Default)"
                                             CanExpand="@canExpand"
                                             ExpandButtonIcon="@(canExpand ? Icons.Material.Filled.ChevronRight : string.Empty)"
                                             Selected="@isSelected"
                                             Style="@activeStyle" 
                                             OnClick="@((e) => OnSelectedChanged(item.Value))"
                                             LoadingIcon="@Icons.Material.Filled.Refresh">

                                @if (NodeContent != null)
                                {
                                    @NodeContent(item.Value!)
                                }

                            </MudTreeViewItem>
                        </ItemTemplate>
                    </MudTreeView>
                </div>
            }
        </ChildContent>
    </BaseToolbarWorkspacePage>
</div>

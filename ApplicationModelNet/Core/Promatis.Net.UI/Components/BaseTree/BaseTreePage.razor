@using Promatis.Net.UI.Components.BaseWorkspace
@typeparam TEntity where TEntity : class

<CascadingValue Value="@ActionContext" IsFixed="true">
    <CascadingValue Value="@((WorkspaceActionContext)ActionContext)" IsFixed="true">

        <BaseWorkspacePage ToolbarContent="@GetTreeToolbarFragment()"
                           BodyContent="@ChildContent" />

    </CascadingValue>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? AdditionalToolbarContent { get; set; }

    /// <summary>
    /// ЕДИНСТВЕННЫЙ источник правды для дерева.
    /// </summary>
    [Parameter] public TreeActionContext ActionContext { get; set; } = null!;

    [Parameter] public EventCallback OnCreateRootTriggered { get; set; }
    [Parameter] public EventCallback OnCreateChildTriggered { get; set; }
    [Parameter] public EventCallback OnDeleteNodeTriggered { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ActionContext ??= new TreeActionContext();
        ActionContext.OnContextUpdated = StateHasChanged;
    }

    private RenderFragment GetTreeToolbarFragment() => __builder =>
    {
        @if (ActionContext.IsCreateRootVisible)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       Disabled="@(!ActionContext.IsCreateRootEnabled)" OnClick="OnCreateRootClick">
                Добавить корень
            </MudButton>
        }
        @if (ActionContext.IsCreateChildVisible)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       Disabled="@(!ActionContext.IsCreateChildEnabled)" OnClick="OnCreateChildClick">
                Добавить подузел
            </MudButton>
        }
        @if (ActionContext.IsDeleteNodeVisible)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                       Disabled="@(!ActionContext.IsDeleteNodeEnabled)" OnClick="OnDeleteNodeClick">
                Удалить узел
            </MudButton>
        }
        @if (AdditionalToolbarContent != null)
        {
            <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
            @AdditionalToolbarContent
        }
    };

    private async Task OnCreateRootClick() { if (OnCreateRootTriggered.HasDelegate) await OnCreateRootTriggered.InvokeAsync(); }
    private async Task OnCreateChildClick() { if (OnCreateChildTriggered.HasDelegate) await OnCreateChildTriggered.InvokeAsync(); }
    private async Task OnDeleteNodeClick() { if (OnDeleteNodeTriggered.HasDelegate) await OnDeleteNodeTriggered.InvokeAsync(); }
}
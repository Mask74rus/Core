@typeparam TEntity where TEntity : class

@* Используем единый командный медиатор для автоматического распределения тулбара и контента *@
<BaseToolbarWorkspacePage TEntity="TEntity"
                          ActionContext="@ActionContext"
                          OnCreateTriggered="OnCreateClick"
                          OnEditTriggered="OnEditClick"
                          OnDeleteTriggered="OnDeleteClick"
                          AdditionalToolbarContent="@AdditionalToolbarContent">
    <ChildContent>
        <MudDataGrid T="TEntity"
                     Items="@Items"
                     ServerData="@ServerData"
                     Loading="@IsLoading"
                     @ref="_grid"
                     SelectedItem="@ActionContext.SelectedData"
                     SelectedItemChanged="@OnSelectedItemChanged"
                     RowStyleFunc="@((item, idx) => item == ActionContext.SelectedData 
                                                                                 ? "background-color: var(--mud-palette-action-disabled-background) !important; color: var(--mud-palette-surface) !important; font-weight: 500;"
                                       : string.Empty)"
                     Hover="true"
                     Dense="true"
                     Striped="false"
                     Bordered="true"
                     Elevation="0"
                     FixedHeader="true"
                     Height="calc(100vh - 280px)">
            <Columns>
                @ColumnsContent
            </Columns>
            <PagerContent>
                @if (PagerContent != null)
                {
                    @PagerContent
                }
                else
                {
                    <MudDataGridPager T="TEntity" InfoFormat="{first_item}-{last_item} из {all_items}" RowsPerPageString="Строк на странице:" />
                }
            </PagerContent>
        </MudDataGrid>
    </ChildContent>
</BaseToolbarWorkspacePage>
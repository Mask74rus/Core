@page "/mdm/all-units"
@using Promatis.Net.UI.Components.BaseWorkspace


<!-- Располагаем панель инструментов вертикально слева -->
<BaseWorkspacePage PageTitle="Топология" Position="ToolbarPosition.Top">

    <ToolbarContent>
        <!-- Кнопки автоматически растянутся во всю ширину боковой панели для удобства клика -->
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            Создать
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete">
            Удалить
        </MudButton>
    </ToolbarContent>

    <BodyContent>
        <MudGrid>
            <!-- Сюда без изменений встает наш Splitter Layout с деревом и карточкой -->
            <MudText>Основной контент страницы...</MudText>
        </MudGrid>
    </BodyContent>

</BaseWorkspacePage>

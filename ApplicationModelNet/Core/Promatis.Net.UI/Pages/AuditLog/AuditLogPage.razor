@page "/audit-logs"

@using Promatis.Net.Domain

@* Внедряем наш автоматически зарегистрированный в DI контекст «полноты власти» страницы *@
@inject AuditLogPageContext Context

@* Прокидываем контекст каскадом вниз, чтобы холст WorkspacePage нативно читал настройки геометрии *@
<CascadingValue Value="@Context" IsFixed="true">
    <WorkspacePage>
        
        <TopContent>
            @* ТУЛБАР: Полностью автономная строчка, рендерит кнопки и заголовок из контекста *@
            <UiToolbar TEntity="AuditLog" ActionContext="@Context">
                <AdditionalContent>
                    @* Декларативно встраиваем пикер дат, связав его напрямую с C#-свойством контекста *@
                    <div class="d-flex align-center gap-3">
                        <MudDateRangePicker Label="Период логов"
                                            @bind-DateRange="Context.Period"
                                            Margin="Margin.Dense"
                                            Style="width: 260px;"
                                            Clearable="false" />
                    </div>
                </AdditionalContent>
            </UiToolbar>
        </TopContent>

        <BodyContent>
            @* ТАБЛИЦА: Чистый визуализатор колонок. Из него стерт весь boilerplate-код *@
            <GridPage TEntity="AuditLog">
                <ColumnsContent>
                    <PropertyColumn T="AuditLog" TProperty="DateTime" Property="x => x.ChangedAt" Title="Дата и время" Format="dd.MM.yyyy HH:mm:ss" HeaderStyle="width: 250px;" Style="width: 250px;" />
                    <PropertyColumn T="AuditLog" TProperty="string" Property="x => x.EntityName" Title="Сущность" Style="width: 200px;" />
                    <PropertyColumn T="AuditLog" TProperty="string" Property="x => x.Action" Title="Операция" Style="width: 120px;">
                        <CellTemplate>
                            <MudChip T="string" Color="@Context.GetActionColor(context.Item.Action)" Size="Size.Small" Variant="Variant.Text">
                                @context.Item.Action
                            </MudChip>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn T="AuditLog" TProperty="string" Property="x => x.ChangedBy" Title="Пользователь" Style="width: 180px;" />
                    <PropertyColumn T="AuditLog" TProperty="Guid" Property="x => x.EntityId" Title="ID Объекта" Style="width: 320px;" Class="font-monospace" />
                    <PropertyColumn T="AuditLog" TProperty="string" Property="x => x.ChangesJson" Title="Изменения (JSON)" CellClass="text-truncate" />
                </ColumnsContent>
            </GridPage>
        </BodyContent>

    </WorkspacePage>
</CascadingValue>

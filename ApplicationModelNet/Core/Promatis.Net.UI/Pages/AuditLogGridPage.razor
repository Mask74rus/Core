@page "/audit-logs"
@using Promatis.Net.Domain
@using Promatis.Net.UI.Components.BaseGrid

@inherits ComponentBase


@* Явно вызываем наш базовый универсальный грид в режиме ServerData *@
<BaseGridPage TEntity="AuditLog"
              @ref="_baseGrid"
              ActionContext="@_context"
              ServerData="@LoadServerData"
              OnIncrementalUpdateRequested="@OnGlobalDataChangedAsync">

    <AdditionalToolbarContent>
        <div class="d-flex align-center gap-3">
            <MudDateRangePicker Label="Период логов"
                                DateRange="@_dateRange"
                                DateRangeChanged="OnDateRangeChanged"
                                Margin="Margin.Dense"
                                Style="width: 260px;"
                                Clearable="false" />
        </div>
    </AdditionalToolbarContent>

    <ColumnsContent>
        <PropertyColumn T="AuditLog" TProperty="DateTime" Property="x => x.ChangedAt" Title="Дата и время" Format="dd.MM.yyyy HH:mm:ss" Style="width: 180px;" />
        <PropertyColumn T="AuditLog" TProperty="string" Property="x => x.EntityName" Title="Сущность" Style="width: 200px;" />
        <PropertyColumn T="AuditLog" TProperty="string" Property="x => x.Action" Title="Action" Style="width: 120px;">
            <CellTemplate>
                <MudChip T="string" Color="@_context.GetActionColor(context.Item.Action)" Size="Size.Small" Variant="Variant.Text">
                    @context.Item.Action
                </MudChip>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn T="AuditLog" TProperty="string" Property="x => x.ChangedBy" Title="Пользователь" Style="width: 180px;" />
        <PropertyColumn T="AuditLog" TProperty="Guid" Property="x => x.EntityId" Title="ID Объекта" Style="width: 320px;" Class="font-monospace" />
        <PropertyColumn T="AuditLog" TProperty="string" Property="x => x.ChangesJson" Title="Изменения (JSON)" CellClass="text-truncate" />
    </ColumnsContent>
</BaseGridPage>

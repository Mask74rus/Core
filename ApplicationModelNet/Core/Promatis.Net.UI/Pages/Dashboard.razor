@page "/"

<MudText Typo="Typo.h4" Class="mb-4">Модуль Master Data Management</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="d-flex flex-row pt-6 pb-4 px-4" Style="height:100px;">
            <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" Size="Size.Large" Class="mr-4" />
            <div>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Статус подключения к БД</MudText>
                <MudText Typo="Typo.h6">Активно (TestBase)</MudText>
            </div>
        </MudPaper>
    </MudItem>
    
    <MudItem xs="12" sm="6" md="8">
        <MudPaper Class="pa-4" Style="height:100px;">
            <MudText Typo="Typo.subtitle1">Добро пожаловать в систему Promatis ERP</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Все интерфейсы подгружены динамически из независимых слоев Razor Class Library.
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

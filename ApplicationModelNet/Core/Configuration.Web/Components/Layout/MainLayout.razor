@inherits LayoutComponentBase
@using Promatis.Net.Ui.Theme
@inject UiModuleService UiService

@* Подключаем глобальную тему из базовой UI библиотеки *@
<MudThemeProvider Theme="PromatisTheme.DefaultTheme" />
<MudPopoverProvider />

@* Ваши жесткие настройки для системных и кастомных диалогов *@
<MudDialogProvider FullWidth="false"
                   MaxWidth="MaxWidth.False"
                   CloseButton="false"
                   BackdropClick="false"
                   NoHeader="false"
                   Position="DialogPosition.Center"
                   CloseOnEscapeKey="true"
                   BackgroundClass="my-custom-class" />

<MudSnackbarProvider />

<CascadingValue Value="this">
    <MudLayout>
        @* Верхняя панель приложения *@
        <MudAppBar Color="Color.Primary" Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           Size="Size.Large"
                           OnClick="ToggleDrawer" />
            <MudStack Spacing="-1">
                @* Дефолтное название *@
                <MudText Typo="Typo.h6" Class="ml-2">
                    @("Тестовый проект Promatis Net")
                </MudText>
            </MudStack>
        </MudAppBar>

        @* Боковая панель с динамическим меню NavMenu *@
        <MudDrawer @bind-Open="_drawerOpen"
                   ClipMode="DrawerClipMode.Always"
                   Variant="DrawerVariant.Persistent"
                   Width="220px"
                   Elevation="1">
            <NavMenu />
        </MudDrawer>

        @* Основной контент приложения с предохранителем ошибок *@
        <MudMainContent Style="padding-left: 20px; margin-top: 20px">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="exception">
                    <MudAlert Severity="Severity.Error" Class="my-4">
                        Произошла критическая ошибка интерфейса: @exception.Message
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudMainContent>
    </MudLayout>
</CascadingValue>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
@inject UiModuleService UiService

<MudNavMenu>
    @{
        // 1. Извлекаем абсолютно все элементы навигации изо всех загруженных модулей
        List<(string Title, string Href, string Icon, string? Group)> allItems = UiService.Modules
            .SelectMany(m => m.GetMenuItems())
            .ToList();

        // 2. Отрисовываем элементы верхнего уровня (у которых Group пустой или null)
        IEnumerable<(string Title, string Href, string Icon, string? Group)> topLevelItems = allItems.Where(i => string.IsNullOrWhiteSpace(i.Group));
        foreach ((string Title, string Href, string Icon, string? Group) item in topLevelItems)
        {
            <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="NavLinkMatch.All">
                @item.Title
            </MudNavLink>
        }

        // 3. Группируем оставшиеся элементы по текстовому названию категории
        IOrderedEnumerable<IGrouping<string, (string Title, string Href, string Icon, string? Group)>> pooledGroups = allItems
            .Where(i => !string.IsNullOrWhiteSpace(i.Group))
            .GroupBy(i => i.Group!)
            .OrderBy(g => g.Key); // Сортируем папки по алфавиту

        foreach (IGrouping<string, (string Title, string Href, string Icon, string? Group)> group in pooledGroups)
        {
            // Expanded="false" для сворачивания разделов по умолчанию
            <MudNavGroup Title="@group.Key" Icon="@Icons.Material.Filled.Folder" Expanded="false">
                @foreach ((string Title, string Href, string Icon, string? Group) item in group)
                {
                    // Корректное обращение к переменной итератора item
                    <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="NavLinkMatch.Prefix">
                        @item.Title
                    </MudNavLink>
                }
            </MudNavGroup>
        }
    }
</MudNavMenu>
@page "/mdm/units"

@using Promatis.Net.MES.Domain
@using Promatis.Net.MES.Domain.Interface

@inherits Microsoft.AspNetCore.Components.ComponentBase

<BaseTreePage TEntity="UnitBase"
              ActionContext="@Context"
              Items="@_rootNodes"
              IsLoading="@_isInitialLoading"
              ServerData="@LoadChildrenAsync"
              ItemTextFunc="@(x => x.Name)"
              CanExpandFunc="@(x => x.Kind != UnitKind.Position)"
              OnCreateRootTriggered="@CreateRootNodeAsync"
              OnCreateChildTriggered="@CreateChildNodeAsync"
              OnEditNodeTriggered="@EditSelectedNodeAsync"
              OnDeleteNodeTriggered="@DeleteNodeAsync">

    <EmptyContent>
        <div class="d-flex flex-column align-center justify-center my-8" style="min-height: 400px;">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Default" Class="mud-text-disabled" Style="font-size: 4rem;" />
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-4">Структура предприятия пуста</MudText>
            <MudText Typo="Typo.body2" Color="Color.Default" Class="mud-text-disabled">Добавьте первый корневой элемент на панели инструментов</MudText>
        </div>
    </EmptyContent>

    <NodeContent Context="unit">
        <div class="d-flex align-center gap-2 w-100 pr-4 py-1">
            <MudIcon Icon="@GetNodeIcon(unit.Kind)" Size="Size.Small" Color="Color.Primary" />
            <div class="d-flex flex-column flex-grow-1">
                <MudText Typo="Typo.body2" Class="font-weight-medium">@unit.Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@unit.Code (@GetTranslate(unit.Type))</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                           Size="Size.Small"
                           Color="Color.Default"
                           Class="pa-1"
                           OnClick="@(() => EditNodeAsync(unit))" />
        </div>
    </NodeContent>

</BaseTreePage>

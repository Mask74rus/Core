@using Promatis.Net.MES.Domain.Interface
@using Promatis.Net.UI.Components.Dialogs;
@inherits Microsoft.AspNetCore.Components.ComponentBase

<BaseEditDialog @ref="_dialog"
                Title="@_title"
                IsNew="@IsNew"
                Model="@Model"
                Validator="@UnitValidator"
                OnSaveAction="@OnSaveInternal"
                Snackbar="@Snackbar">
    <FormContent>
        <div class="d-flex flex-column gap-4" style="width: 550px; max-width: 100%;">
            
            <MudTextField @bind-Value="Model.Name" 
                          For="@(() => Model.Name)" 
                          Label="Наименование" 
                          Variant="Variant.Outlined" 
                          Required="true" />

            <MudTextField @bind-Value="Model.Code" 
                          For="@(() => Model.Code)" 
                          Label="Системный код (латиница)" 
                          Variant="Variant.Outlined" 
                          HelperText="Только заглавные латинские буквы, цифры и '_'" />

            <MudSelect T="UnitType" 
                       @bind-Value="Model.Type" 
                       For="@(() => Model.Type)"
                       Label="Тип производственного узла" 
                       Variant="Variant.Outlined" 
                       Required="true">
                @foreach (UnitType type in _availableTypes)
                {
                    <MudSelectItem Value="@type">@GetTranslate(type)</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="Model.Description" 
                          For="@(() => Model.Description)" 
                          Label="Описание / Примечание" 
                          Variant="Variant.Outlined" 
                          Lines="3" />
        </div>
    </FormContent>
</BaseEditDialog>

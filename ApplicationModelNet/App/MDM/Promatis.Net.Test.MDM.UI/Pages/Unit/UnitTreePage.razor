@page "/mdm/units"

@using Promatis.Net.MES.Domain
@using Promatis.Net.UI.Components.Tree

@inject UnitTreePageContext Context

<CascadingValue Value="@Context" IsFixed="true">
    <WorkspacePage>

        <TopContent>
            @* ТУЛБАР: Автономно рендерит кнопки управления на основе контекста *@
            <UiToolbar TEntity="UnitBase"
                       ActionContext="@Context"
                       OnCreateTriggered="@Context.OnCreateRootActionAsync"
                       OnCreateChildTriggered="@Context.OnCreateChildActionAsync"
                       OnEditTriggered="@Context.OnUpdateActionAsync"
                       OnDeleteTriggered="@Context.OnDeleteActionAsync" />
        </TopContent>

        <BodyContent>
            @* ДЕРЕВО: Теперь выводит красивый префикс типа объекта из Enum *@
            <TreePage TEntity="UnitBase" 
                      NodeTextSelector="@(x => $"[{x.Code}] ({x.Type.GetDescription()}) {x.Name}")" />
        </BodyContent>

    </WorkspacePage>
</CascadingValue>
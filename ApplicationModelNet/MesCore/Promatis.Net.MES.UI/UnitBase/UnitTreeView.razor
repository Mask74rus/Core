@typeparam TUnit where TUnit : Promatis.Net.MES.Domain.UnitBase, Promatis.Net.Domain.Interface.ITreeNode<TUnit>
@inherits Promatis.Net.UI.BaseTreeView<TUnit>

@using Promatis.Net.UI

<MudPaper Elevation="1" Class="pa-4 font-sans">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h6">@Title</MudText>
        @if (IsLoadingRoot)
        {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
    </div>

    <!--
        Полное соответствие типов MudBlazor v9.4.0:
        T: Тип данных (TreeRowModel<TUnit>)
        Items: List<TreeItemData<TreeRowModel<TUnit>>>
        ServerData: Метод, принимающий TreeRowModel<TUnit> и возвращающий IReadOnlyCollection<TreeItemData<TreeRowModel<TUnit>>>
    -->
    <MudTreeView T="TreeRowModel<TUnit>"
                 ServerData="LoadTreeNodesAsync"
                 Items="RootItems"
                 Hover="true"
                 SelectedValueChanged="OnNodeSelectedInternal">
        <ItemTemplate>
            @if (context.Value != null)
            {
                <div class="d-flex align-center justify-space-between w-100 pr-2 py-1">
                    <div class="d-flex align-center gap-2">
                        <!-- Иконка из доменного объекта -->
                        <MudIcon Icon="@GetNodeIcon(context.Value.DomainEntity)"
                                 Color="@GetNodeIconColor(context.Value.DomainEntity)"
                                 Size="Size.Medium" />
                        <div>
                            <!-- Текст и код из адаптера -->
                            <MudText Typo="Typo.body1">@context.Value.Name</MudText>
                            @if (!string.IsNullOrEmpty(context.Value.Code))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Код: @context.Value.Code</MudText>
                            }
                        </div>
                    </div>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@GetChipColor(context.Value.DomainEntity)">
                        @context.Value.DomainEntity.Type.ToString()
                    </MudChip>
                </div>
            }
        </ItemTemplate>
    </MudTreeView>
</MudPaper>

@code {
    private string GetNodeIcon(TUnit unit) => unit.Kind switch
    {
        Domain.Interface.UnitKind.Production => Icons.Material.Filled.PrecisionManufacturing,
        Domain.Interface.UnitKind.Storage => Icons.Material.Filled.Warehouse,
        Domain.Interface.UnitKind.Transport => Icons.Material.Filled.LocalShipping,
        Domain.Interface.UnitKind.Department => Icons.Material.Filled.CorporateFare,
        _ => Icons.Material.Filled.Folder
    };

    private Color GetNodeIconColor(TUnit unit) => unit.Kind switch
    {
        Domain.Interface.UnitKind.Production => Color.Warning,
        Domain.Interface.UnitKind.Storage => Color.Info,
        Domain.Interface.UnitKind.Transport => Color.Success,
        Domain.Interface.UnitKind.Department => Color.Primary,
        _ => Color.Default
    };

    private Color GetChipColor(TUnit unit) => unit.Kind switch
    {
        Domain.Interface.UnitKind.Production => Color.Warning,
        Domain.Interface.UnitKind.Storage => Color.Info,
        _ => Color.Default
    };
}
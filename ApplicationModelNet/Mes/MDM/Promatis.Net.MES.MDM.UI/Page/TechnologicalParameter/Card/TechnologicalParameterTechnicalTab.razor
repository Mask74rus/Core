
<div class="d-flex flex-column gap-4 pt-2">

    <MudTextField Label="Единица измерения"
                  @bind-Value="Model.UnitOfMeasurement"
                  For="@(() => Model.UnitOfMeasurement)"
                  Margin="Margin.Dense"
                  Variant="Variant.Outlined"
                  Required="true"
                  HelperText="Например: мм, об/мин, °C" />

    <MudSelect T="string"
               Label="Тип данных параметра"
               @bind-Value="Model.DataType"
               For="@(() => Model.DataType)"
               Margin="Margin.Dense"
               Variant="Variant.Outlined"
               Required="true">
        @foreach (string type in AllowedDataTypes)
        {
            <MudSelectItem Value="@type">@type</MudSelectItem>
        }
    </MudSelect>

</div>

@code {
    [Parameter] public Domain.TechnologicalParameter Model { get; set; } = null!;

    protected readonly string[] AllowedDataTypes = ["Numeric", "String", "Boolean", "DateTime"];
}

@inherits Microsoft.AspNetCore.Components.ComponentBase

<BaseEditDialog Title="@(IsNew ? "Создание технологического параметра" : "Редактирование технологического параметра")"
                IsNew="@IsNew"
                Model="@Model"
                Validator="@Validator"
                OnSaveAction="@SaveParameterAsync"
                Snackbar="@Snackbar">
    <FormContent>
        @* Потоковая валидация теперь идет через функцию обратного вызова FluentValidation *@
        <MudTextField @bind-Value="Model.Code"
                      For="@(() => Model.Code)"
                      Immediate="true"
                      Label="Код параметра (только латиница в верхнем регистре, цифры, _)"
                      Variant="Variant.Outlined" />

        <MudTextField @bind-Value="Model.Name"
                      For="@(() => Model.Name)"
                      Immediate="true"
                      Label="Наименование"
                      Variant="Variant.Outlined" />

        @* ИСПРАВЛЕНО: Поскольку DataType теперь обычная строка без ограничений, используем MudTextField *@
        <MudTextField @bind-Value="Model.DataType"
                      For="@(() => Model.DataType)"
                      Immediate="true"
                      Label="Тип данных"
                      Variant="Variant.Outlined" />

        <MudTextField @bind-Value="Model.UnitOfMeasurement"
                      For="@(() => Model.UnitOfMeasurement)"
                      Immediate="true"
                      Label="Единица измерения"
                      Variant="Variant.Outlined" />

        <MudTextField @bind-Value="Model.Description"
                      For="@(() => Model.Description)"
                      Label="Описание"
                      Variant="Variant.Outlined"
                      Lines="3" />
    </FormContent>
</BaseEditDialog>

@page "/mes/mdm/technological-operations"
@using Promatis.Net.MES.MDM.Domain

@inject TechnologicalOperationPageContext Context

<CascadingValue Value="@Context" IsFixed="true">
    <WorkspacePage>

        <TopContent>
            @* ТУЛБАР: Располагается сверху, нативно маршалирует команды в контекст операций *@
            <UiToolbar TEntity="TechnologicalOperation"
                       ActionContext="@Context"
                       OnCreateTriggered="@Context.OnCreateRootOrSiblingActionAsync"
                       OnCreateChildTriggered="@Context.OnCreateChildActionAsync"
                       OnEditTriggered="@Context.OnUpdateActionAsync"
                       OnDeleteTriggered="@Context.OnDeleteActionAsync" />
        </TopContent>

        <BodyContent>
            @* ДЕРЕВО: Передаем селектор текста с красивым отображением статуса операции *@
            <TreePage TEntity="TechnologicalOperation"
                      NodeTextSelector="@(x => $"[{x.Code}] {(x.IsLeaf ? "🔹" : "📁")} {x.Name}")" />
        </BodyContent>

    </WorkspacePage>
</CascadingValue>

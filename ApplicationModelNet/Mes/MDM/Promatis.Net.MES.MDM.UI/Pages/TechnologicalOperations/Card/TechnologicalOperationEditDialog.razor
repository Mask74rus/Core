<EditDialog Title="@Title"
            IsNew="@IsNew"
            Model="@Model"
            Validator="@Validator"
            OnSaveAction="@OnSaveAction">
    <Tabs>
        @* ВКЛАДКА 1: Основные свойства технологической операции *@
        <DialogTab Title="Основное" Icon="@Icons.Material.Filled.Info">
            <Content>
                <div class="d-flex flex-column gap-4 pt-2">

                    <MudTextField Label="Наименование"
                                  @bind-Value="Model.Name"
                                  For="@(() => Model.Name)"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Required="true" />

                    <MudTextField Label="Системный код"
                                  @bind-Value="Model.Code"
                                  For="@(() => Model.Code)"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  HelperText="Только латиница в верхнем регистре, цифры и _" />

                    <MudTextField Label="Описание / Примечание"
                                  @bind-Value="Model.Description"
                                  For="@(() => Model.Description)"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Lines="3" />

                    @* УПРАВЛЕНИЕ СТАТУСОМ ТЕРМИНАЛЬНОГО УЗЛА (ЛИСТА) С ЗАЩИТОЙ ДОМЕНА *@
                    <div class="d-flex align-center mt-2 pl-1">
                        <MudCheckBox T="bool"
                                     Label="Является конечной операцией (Листом техпроцесса)"
                                     @bind-Value="Model.IsLeaf"
                                     Disabled="@IsLeafModificationDisabled()"
                                     Color="Color.Primary" />
                    </div>

                </div>
            </Content>
        </DialogTab>

        @* ВКЛАДКА 2: Динамический полиморфный рендеринг параметров связи *@
        @if (Model.IsLeaf)
        {
            <DialogTab Title="Технологические параметры" Icon="@Icons.Material.Filled.Assignment">
                <Content>
                    <div class="d-flex flex-column gap-4 pt-2">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="italic">
                            Специфичные связи операции со справочником технологических параметров (TPLink)
                        </MudText>
                        @* Здесь разместится будущая таблица/грид параметров связи *@
                    </div>
                </Content>
            </DialogTab>
        }
    </Tabs>
</EditDialog>

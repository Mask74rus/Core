<div class="d-flex flex-column gap-4 pt-2">
    <MudTextField Label="Наименование" @bind-Value="Model.Name" For="@(() => Model.Name)" Margin="Margin.Dense" Variant="Variant.Outlined" Required="true" />
    <MudTextField Label="Системный код" @bind-Value="Model.Code" For="@(() => Model.Code)" Margin="Margin.Dense" Variant="Variant.Outlined" HelperText="Только латиница в верхнем регистре, цифры и _" />
    <MudTextField Label="Описание / Примечание" @bind-Value="Model.Description" For="@(() => Model.Description)" Margin="Margin.Dense" Variant="Variant.Outlined" Lines="3" />
</div>

@code {
    [Parameter] public Domain.TechnologicalParameter Model { get; set; } = null!;
}

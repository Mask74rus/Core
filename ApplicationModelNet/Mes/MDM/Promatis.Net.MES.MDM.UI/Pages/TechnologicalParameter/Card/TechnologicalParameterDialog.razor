
<EditDialog Title="@Title"
            IsNew="@IsNew"
            Model="@Model"
            Validator="@Validator"
            OnSaveAction="@OnSaveAction">
    <Tabs>
        @* КОМПОНЕНТ ВКЛАДКИ 1 *@
        <DialogTab Title="Основное" Icon="@Icons.Material.Filled.Info">
            <Content>
                <TechnologicalParameterGeneralTab Model="@Model" />
            </Content>
        </DialogTab>

        @* КОМПОНЕНТ ВКЛАДКИ 2 *@
        <DialogTab Title="Конфигурация DCA" Icon="@Icons.Material.Filled.Settings">
            <Content>
                <TechnologicalParameterTechnicalTab Model="@Model" />
            </Content>
        </DialogTab>
    </Tabs>
</EditDialog>
